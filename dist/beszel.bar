<bar protocol-version="0" min-app-version="0.3.0" id="beszel" title="Beszel" version="0.2.0" description="Monitor your self-hosted Beszel servers, containers, and alerts." icon="tabler:server" category="monitor" refresh="1m" material="solid" open-mode="flyout" window-style="standard" widget="true" notch="true" homepage="https://github.com/miantiao-me/beszel.bar" license="Apache-2.0">
  <locale lang="zh-Hans" title="Beszel" description="监控自建 Beszel 主机、容器与告警。" />
  <permissions>
    <network origin="{{ inputs.server }}" from-url="true" allow-http="true" />
    <network origin="https://esm.sh" />
    <inbox access="manage" />
  </permissions>
  <inputs>
    <input name="lang" type="select" label="Language" default="auto">
      <locale lang="zh-Hans" label="语言" />
      <option value="auto" label="Follow Metrix.Bar"><locale lang="zh-Hans" label="跟随 Metrix.Bar" /></option>
      <option value="en" label="English" />
      <option value="zh" label="简体中文" />
    </input>
    <input name="server" type="string" label="Server URL" default="http://127.0.0.1:8090" placeholder="https://beszel.example.com" help="Your Beszel URL. Local HTTP is supported." required="true">
      <locale lang="zh-Hans" label="服务器地址" help="Beszel 地址，支持内网 HTTP。" />
    </input>
    <input name="email" type="secret" label="Email" help="Account email. A read-only user is recommended." required="true">
      <locale lang="zh-Hans" label="邮箱" help="登录邮箱，建议使用只读账号。" />
    </input>
    <input name="password" type="secret" label="Password" required="true">
      <locale lang="zh-Hans" label="密码" />
    </input>
    <input name="refreshInterval" type="select" label="Refresh Interval" default="30" help="How often to refresh data.">
      <locale lang="zh-Hans" label="刷新间隔" help="数据刷新频率。" />
      <option value="15" label="15s"><locale lang="zh-Hans" label="15 秒" /></option>
      <option value="30" label="30s"><locale lang="zh-Hans" label="30 秒" /></option>
      <option value="60" label="60s"><locale lang="zh-Hans" label="60 秒" /></option>
    </input>
    <input name="trayFormat" type="select" label="Menu Bar" default="online" help="What to show in the menu bar.">
      <locale lang="zh-Hans" label="菜单栏显示" help="菜单栏显示的内容。" />
      <option value="online" label="Online (4/5)"><locale lang="zh-Hans" label="在线数 (4/5)" /></option>
      <option value="online_rate" label="Online + Bandwidth"><locale lang="zh-Hans" label="在线数与带宽" /></option>
      <option value="cpu" label="Average CPU"><locale lang="zh-Hans" label="平均 CPU" /></option>
      <option value="rate_spark" label="Bandwidth Sparkline (macOS)"><locale lang="zh-Hans" label="带宽迷你图 (macOS)" /></option>
      <option value="cpu_spark" label="CPU Sparkline (macOS)"><locale lang="zh-Hans" label="CPU 迷你图 (macOS)" /></option>
    </input>
    <input name="notchMetric" type="select" label="Notch Metric" default="online" help="Metric shown in the screen notch (Plus).">
      <locale lang="zh-Hans" label="刘海屏指标" help="刘海屏显示的数值（Plus）。" />
      <option value="online" label="Online (4/5)"><locale lang="zh-Hans" label="在线数 (4/5)" /></option>
      <option value="cpu" label="Average CPU (48%)"><locale lang="zh-Hans" label="平均 CPU (48%)" /></option>
      <option value="rate" label="Bandwidth (14.6M)"><locale lang="zh-Hans" label="实时带宽 (14.6M)" /></option>
    </input>
    <input name="widgetMode" type="select" label="Desktop Widget" default="overview" help="What desktop widgets display.">
      <locale lang="zh-Hans" label="桌面小组件" help="桌面小组件显示的内容。" />
      <option value="overview" label="Overview"><locale lang="zh-Hans" label="集群总览" /></option>
      <option value="system" label="Single Server"><locale lang="zh-Hans" label="单台主机" /></option>
      <option value="alerts" label="Alerts"><locale lang="zh-Hans" label="告警" /></option>
    </input>
    <input name="widgetSystem" type="string" label="Widget Server" help="Single Server widget only. Leave blank to follow the selected server.">
      <locale lang="zh-Hans" label="小组件主机" help="仅单台主机小组件生效，留空跟随当前选中主机。" />
    </input>
    <input name="notify" type="bool" label="Notifications" default="false" help="Notify on outages, high load, or new alert messages.">
      <locale lang="zh-Hans" label="桌面通知" help="主机离线、超阈或收到告警消息时提醒。" />
    </input>
    <input name="threshold" type="integer" label="Alert Threshold %" default="90" help="Alert when CPU, memory, or disk reaches this value (0 to disable).">
      <locale lang="zh-Hans" label="告警阈值 %" help="资源达到该百分比时提醒，0 为关闭。" />
    </input>
  </inputs>
  <docs><![CDATA[Monitor your self-hosted Beszel servers in read-only mode.

Quick Start
1. Enter your Beszel URL (e.g. https://beszel.example.com or http://10.0.0.2:8090).
2. Enter your email and password (a read-only account is recommended).

Optional: Alert Messages (Metrix.Bar Plus)
1. Create an Inbox in Metrix.Bar and bind it to this dashboard with manage access.
2. In Beszel Settings > Notifications, add a Webhook using your Inbox URL with the generic:// scheme:
   generic://agili-inbox.com/h/<inbox-id>/<secret>
   (Append ?template=json if preferred, or send to <inbox-id>@agili-inbox.com if SMTP is configured.)]]>
    <locale lang="zh-Hans"><![CDATA[以只读方式监控自建 Beszel 主机、容器与告警。

快速开始
1. 填写 Beszel 地址（如 https://beszel.example.com 或内网 http://10.0.0.2:8090）。
2. 填写登录邮箱与密码（建议使用只读账号）。

可选：接收告警推送（Metrix.Bar Plus）
1. 在 Metrix.Bar 中创建收件箱并绑定到此看板（开启管理权限以便删除消息）。
2. 在 Beszel「设置 → 通知」中添加 Webhook，将收件箱 Webhook 地址的 https:// 改为 generic://：
   generic://agili-inbox.com/h/<inbox-id>/<secret>
   （如需 JSON 格式可追加 ?template=json；如已配置 SMTP 也可直接填 <inbox-id>@agili-inbox.com。）]]></locale>
  </docs>
